#lang htdp/isl+

; Number N -> Number
; Raises n in into power pow
(check-expect (my-expt 2 2) 4)
(define (my-expt n pow)
  (cond
    [(zero? pow) 1]
    [else (* n (my-expt n (- pow 1)))]))

(define inex (+ 1 #i1e-12))
(define exac (+ 1 1e-12))

(my-expt inex 30) ;; #i1.0000000000300027
(my-expt exac 30) ;; 
